#!/usr/bin/env perl
use strict;
use warnings;

my $command = shift @ARGV // '';
my @args = @ARGV;
my @created_files = ();

if($command eq 'create-project') {
    create_project(@args);
}
elsif($command eq 'generate') {
    generate(@args);
}
elsif($command eq 'runserver') {
    runserver(@args);
} 
else {
    print "Usage: subpar <command> [args]\n";
    print "Commands: create-project, runserver [port]\n";
    exit 1;
}


sub create_project  {
    my ($path) = @_;

    $path //= ".";

    eval {
        create_file("$path/app.psgi", app_psgi_template());
        create_file("$path/settings.pl", settings_template());
        mkdir "$path/Controller" or die "./Controller: cannot create directory: $!";
        mkdir "$path/Model" or die "./Model: cannot create directory: $!";
        mkdir "$path/Repository" or die "./Repository: cannot create directory: $!";
    };

    cleanup_if_err();

    print "\nDone! Now create an app:\n";
    print "  subpar generate <controller|model|repository|all> <name> \n";
}

sub generate {
    my ($option, $name) = @_;

    die "Choose a generation mode please [controller|model|repository|all]" unless defined $option;
    die "You need to choose a name for the generation!" unless defined $name;

    $option = lc $option;

    eval {
        if($option eq 'all') {
            generate_all($name);
        }
        elsif($option eq 'controller') {
            generate_controller($name);
        }
        elsif($option eq 'model') {
            generate_model($name);
        }
        elsif($option eq 'repository') {
            generate_repository($name);
        }
        else {
            die "This is not a valid option!"
        }
    };

    cleanup_if_err();
}

sub generate_controller {
    my ($name) = @_;

    create_file("./Controller/" . $name . "Controller.pm", controller_template($name));
}

sub generate_model {
    my ($name) = @_;

    create_file("./Model/" . $name . ".pm", model_template($name));
}

sub generate_repository {
    my ($name) = @_;

    create_file("./Repository/" . $name . "Repository.pm", repository_template($name));
}

sub generate_all {
    my ($name) = @_;

    generate_controller($name);
    generate_model($name);
    generate_repository($name);
}

sub create_file {
    my ($path, $template) = @_;

    if(-e $path) {
        die $path . ": file already exists!";
    }

    open my $fh, '>', $path or die $path . ": file could not be open!";
    print $fh $template;
    close $fh;

    push @created_files, $path;

    print "Created $path\n";
}

sub app_psgi_template {
    <<END;
use strict;
use warnings;

use SubPar::Server;

my \$server = SubPar::Server->new();
\$server->register_controllers();

my \$app = \$server->to_psgi;
END
}

sub settings_template {
    <<END;
{
    port => 8080,

    databases => {
        main => {
            driver        => 'yourDriver',
            database_name => 'yourDbName',
            hostname      => 'yourHostname',
            port          => 'yourPort',
            username      => 'yourUsername',
            password      => 'yourPassword',
        }
    },
}
END
}

sub controller_template {
    my ($name) = @_;
    $name = $name . "Controller";

    <<END;
package $name;

use strict;
use warnings;

use parent 'SubPar::Controller';

# Inject your repositories here.
sub repositories {
    my (\$self) = \@_;
}

# Setup your routes here.
sub routes {
    my (\$self) = \@_;
}

1;
END
}

sub model_template {
    my ($name) = @_;
    $name = $name . "Model";

    <<END;
package $name;

use strict;
use warnings;

use parent 'SubPar::Model';

# Declare model fields here. Must match physical database column names.
sub fields {
    return {
    };
}

1;
END
}

sub repository_template {
    my ($name) = @_;
    $name = $name . "Repository";

    <<END;
package Repository::$name;

use strict;
use warnings;

use parent 'SubPar::Repository';

# Declare table name here. Must match physical database table name.
sub table { '$name' }

1;
END
}

sub cleanup_if_err {

    if ($@) {
        my $err = $@;
        $err =~ s/\n$//;

        unlink $_ for @created_files;
        print "Error: $err\n";
        print "All created files have been reverted\n" if @created_files;
        exit 1;
    }
}

sub runserver  {
    my ($port) = @_;
    $port //= 8080;
    print "Starting SubPar server on port $port...\n";
    print "Press Ctrl+C to stop.\n\n";
    exec "starman -I . --port $port app.psgi";
}